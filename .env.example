# ---------------------------------------------------------------------------
# Lead Sniper — environment template
# Copy this file to `.env` and fill in the values below.
# Never commit `.env` to version control.
# ---------------------------------------------------------------------------

# Telegram API credentials — create an app at https://my.telegram.org/apps
# TG_API_ID is an integer, TG_API_HASH is a 32-char hex string.
TG_API_ID=
TG_API_HASH=

# Telethon session name. The authorized session is stored as
# `<TG_SESSION_NAME>.session` in the project root. Defaults to
# `session_auth_test` when left empty.
TG_SESSION_NAME=

# Phone number used by `python auth_test.py` to request a login code.
# International format, E.164, e.g. +79991234567. Leave empty to be prompted
# interactively on each run. The login code is always entered in the terminal;
# the 2FA cloud password is never stored here.
TG_PHONE=

# Chats watched in `python main.py --live`, comma-separated (usernames or ids).
# `python join_chats.py` merges successfully resolved chats into this value.
# Curated marketplace/cargo/fulfillment targets include:
#   wb_chat_sellers, fulfillment_russia, cargo_china_chat,
#   chat_wildberries_ozon, sellers_wildberries, market_place_ru,
#   wb_sellers_club, marketplace_help, chatozonwb, ff_sklad_wb,
#   fulfillment_moscow, chinacargo_chat, dostavka_iz_kitaya_cargo,
#   wb_managers, infografika_wb_ozon
# Example: TG_MONITOR_CHATS=@cargo_chat_moscow,@ecom_russia
# Leave empty to listen to every chat the account receives messages from.
# May be overridden per run with the --chats CLI flag.
TG_MONITOR_CHATS=

# Optional proxy. Leave PROXY_HOST empty (or 127.0.0.1) to connect directly.
# PROXY_USER / PROXY_PASS may be left empty for unauthenticated proxies.
# PROXY_TYPE is one of: socks5 | socks4 | http (default: http).
# Set it to the scheme the endpoint really speaks — some providers advertise
# a SOCKS5 port that only accepts HTTP CONNECT, which makes SOCKS5 time out.
PROXY_TYPE=http
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# LLM lead classifier (Sprint 3). Any OpenAI-compatible endpoint works.
# LLM_API_KEY is required for classification; leave it empty to disable the
# LLM stage (the pipeline will simply skip classification).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Telegram alert notifier (Sprint 4). Create a bot via @BotFather and paste its
# token below. TELEGRAM_ALERT_CHAT_ID accepts either a numeric chat id
# (e.g. -1001234567890) or a public channel username (e.g. @my_leads_channel).
# Leave both empty to disable alert dispatch.
# The same credentials deliver the `auto_discover.py` session summary.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Smart chat discovery / safe joiner (Sprint 5, `python auto_discover.py`).
# Pre-join activity gates and anti-flood limits; all fields are optional and
# fall back to the defaults shown below.
DISCOVERY_MIN_MEMBERS=50
DISCOVERY_DAILY_JOIN_LIMIT=5
DISCOVERY_MAX_AGE_HOURS=48
DISCOVERY_MIN_MESSAGES_7D=5
DISCOVERY_HISTORY_LIMIT=10
