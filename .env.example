# ---------------------------------------------------------------------------
# Lead Sniper — environment template
# Copy this file to `.env` and fill in the values below.
# Never commit `.env` to version control.
# ---------------------------------------------------------------------------

# Telegram API credentials — create an app at https://my.telegram.org/apps
# TG_API_ID is an integer, TG_API_HASH is a 32-char hex string.
TG_API_ID=
TG_API_HASH=

# Telethon session name. The authorized session is stored as
# `<TG_SESSION_NAME>.session` in the project root. Defaults to
# `session_auth_test` when left empty.
TG_SESSION_NAME=

# Chats watched in `python main.py --live`, comma-separated (usernames or ids).
# Example: TG_MONITOR_CHATS=@cargo_chat_moscow,@ecom_russia
# Leave empty to listen to every chat the account receives messages from.
# May be overridden per run with the --chats CLI flag.
TG_MONITOR_CHATS=

# Optional SOCKS5 proxy. Leave PROXY_HOST empty (or 127.0.0.1) to connect
# directly. PROXY_USER / PROXY_PASS may be left empty for unauthenticated
# proxies.
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# LLM lead classifier (Sprint 3). Any OpenAI-compatible endpoint works.
# LLM_API_KEY is required for classification; leave it empty to disable the
# LLM stage (the pipeline will simply skip classification).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Telegram alert notifier (Sprint 4). Create a bot via @BotFather and paste its
# token below. TELEGRAM_ALERT_CHAT_ID accepts either a numeric chat id
# (e.g. -1001234567890) or a public channel username (e.g. @my_leads_channel).
# Leave both empty to disable alert dispatch.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
